{
  "compilerOptions": {
    "downlevelIteration": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "outDir": "dist",
    "removeComments": true,
    "strictNullChecks": true
  },
  "include": [
    ".config/**/*",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}